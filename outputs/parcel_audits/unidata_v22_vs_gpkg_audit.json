 than in the source for that city key). Columns ending in <em>_empty</em> count Unidata rows missing that attribute, using the rules in &ldquo;Column meanings&rdquo; below.</p>\n        <p>This HTML matches the exported CSV schema; regenerate both files together so timestamps stay in sync.</p>\n      </div>\n    </section>\n    <section class=\"grid\">\n      <div class=\"kpi\"><div class=\"kpi-label\">Total Cities</div><div class=\"kpi-value\" id=\"kpiCities\">-</div></div>\n      <div class=\"kpi\"><div class=\"kpi-label\">Source Rows</div><div class=\"kpi-value\" id=\"kpiSourceRows\">-</div></div>\n      <div class=\"kpi\"><div class=\"kpi-label\">Target Rows</div><div class=\"kpi-value\" id=\"kpiTargetRows\">-</div></div>\n      <div class=\"kpi\"><div class=\"kpi-label\">Total Row Delta</div><div class=\"kpi-value\" id=\"kpiDelta\">-</div></div>\n    </section>\n\n    <section class=\"panel\">\n      <div class=\"panel-header\"><h2>Row delta (net shortfall vs GPKG)</h2></div>\n      <div class=\"panel-body\">\n        <p><code>row_delta</code> = <code>unidata_rows</code> − <code>expected_gpkg_rows</code> per city.\n        Negative means Unidata has fewer parcels than the GPKG layer for that city key; positive means Unidata has more.</p>\n        <p>The total row delta is the sum across cities: shortfalls (-2349) plus surpluses (+2306) = <strong>-43</strong>.</p>\n        <p><strong>Fewer rows in Unidata than GPKG (negative row_delta)</strong> (10 cities)</p>\n        <div class=\"table-wrap\"><table><thead><tr><th>city</th><th>unidata_rows</th><th>expected_gpkg_rows</th><th>row_delta</th></tr></thead><tbody><tr><td>DIABLO-RANGE</td><td>0</td><td>787</td><td>-787</td></tr><tr><td>SOUTH-SANTA-CLARA-VALLEY</td><td>0</td><td>387</td><td>-387</td></tr><tr><td>LLAGAS-UVAS</td><td>0</td><td>321</td><td>-321</td></tr><tr><td>LOS ALTOS HILLS</td><td>0</td><td>304</td><td>-304</td></tr><tr><td>LEXINGTON-HILLS</td><td>0</td><td>201</td><td>-201</td></tr><tr><td>SAN-JOSE</td><td>0</td><td>193</td><td>-193</td></tr><tr><td>LEXINGTON HILLS</td><td>0</td><td>94</td><td>-94</td></tr><tr><td>WEST-SANTA-CLARA</td><td>0</td><td>40</td><td>-40</td></tr><tr><td>PALO ALTO</td><td>21023</td><td>21044</td><td>-21</td></tr><tr><td>STANFORD</td><td>1094</td><td>1095</td><td>-1</td></tr></tbody></table></div>\n        <p><strong>More rows in Unidata than GPKG (positive row_delta)</strong> (6 cities)</p>\n        <div class=\"table-wrap\"><table><thead><tr><th>city</th><th>unidata_rows</th><th>expected_gpkg_rows</th><th>row_delta</th></tr></thead><tbody><tr><td>SAN RAMON</td><td>787</td><td>0</td><td>787</td></tr><tr><td>SANTA CLARA</td><td>30662</td><td>30235</td><td>427</td></tr><tr><td>MORGAN HILL</td><td>17089</td><td>16768</td><td>321</td></tr><tr><td>LOS GATOS</td><td>15572</td><td>15277</td><td>295</td></tr><tr><td>LOS ALTOS</td><td>15987</td><td>15693</td><td>294</td></tr><tr><td>SAN JOSE</td><td>254076</td><td>253894</td><td>182</td></tr></tbody></table></div>\n      </div>\n    </section>\n    \n    <div class=\"panel\">\n      <div class=\"panel-header\"><h2>Controls</h2></div>\n      <div class=\"panel-body\">\n        <div class=\"controls\">\n          <label for=\"cityFilter\"><strong>Filter first column:</strong></label>\n          <input id=\"cityFilter\" type=\"text\" placeholder=\"Type to filter rows\" onkeyup=\"filterCity()\" />\n          <span class=\"chip\">Click header to sort</span>\n          <span class=\"chip\">Dynamic columns from CSV schema</span>\n        </div>\n      </div>\n    </div>\n    <div class=\"panel\">\n      <div class=\"panel-header\"><h2>Column meanings</h2></div>\n      <div class=\"panel-body\">\n        <div class=\"table-wrap\">\n          <table>\n            <thead><tr><th>Column</th><th>Meaning</th></tr></thead>\n            <tbody>\n              <tr><td><code>city</code></td><td>Normalized city key used for grouping both datasets.</td></tr><tr><td><code>unidata_rows</code></td><td>Total rows found in the Unidata target table.</td></tr><tr><td><code>expected_gpkg_rows</code></td><td>Expected rows from the GPKG source table for this city.</td></tr><tr><td><code>row_delta</code></td><td>Difference: unidata_rows - expected_gpkg_rows (negative means missing in Unidata).</td></tr><tr><td><code>footprints_empty</code></td><td>Unidata rows where footprints is null or an empty varchar[] (no geometry strings).</td></tr><tr><td><code>building_area_empty</code></td><td>Unidata rows where building_area is null, blank, or zero (integer column; zero treated as empty).</td></tr><tr><td><code>fldzone_empty</code></td><td>Unidata rows where fldzone is null/blank.</td></tr><tr><td><code>alquist_fault_empty</code></td><td>Unidata rows where alquist_fault is null (boolean; FALSE counts as populated).</td></tr><tr><td><code>liquefaction_empty</code></td><td>Unidata rows where liquefaction is null (boolean; FALSE counts as populated).</td></tr><tr><td><code>landslide_empty</code></td><td>Unidata rows where landslide is null (boolean; FALSE counts as populated).</td></tr><tr><td><code>fhszsra_empty</code></td><td>Unidata rows where fhszsra is null or blank text (integer).</td></tr><tr><td><code>fhszlra_empty</code></td><td>Unidata rows where fhszlra is null or blank text (integer).</td></tr>\n            </tbody>\n          </table>\n        </div>\n      </div>\n    </div>\n    <div class=\"panel\">\n      <div class=\"panel-header\"><h2>Audit Table</h2></div>\n      <div class=\"panel-body\">\n        <div class=\"table-wrap\">\n          <table id=\"auditTable\">\n            <thead><tr><th onclick=\"sortTable(0)\" title=\"Click to sort\">city</th><th onclick=\"sortTable(1)\" title=\"Click to sort\">unidata_rows</th><th onclick=\"sortTable(2)\" title=\"Click to sort\">expected_gpkg_rows</th><th onclick=\"sortTable(3)\" title=\"Click to sort\">row_delta</th><th onclick=\"sortTable(4)\" title=\"Click to sort\">footprints_empty</th><th onclick=\"sortTable(5)\" title=\"Click to s